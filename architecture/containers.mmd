    Rel(enrich, mart, "Пишет актуальный срез", "SQL")
    Rel(mart, cache, "Читает/прогревает кэш", "Redis")

    Rel(crm, gateway, "Запросы к платформе", "REST/JSON")
    Rel(abs, gateway, "Запросы к платформе", "REST/JSON")

    Rel(gateway, clientinfo, "Проксирует запрос", "REST/JSON")
    Rel(gateway, groupcomp, "Проксирует запрос", "REST/JSON")
    Rel(gateway, scoring, "Проксирует запрос", "REST/JSON")

    Rel(clientinfo, mart, "Читает данные", "SQL")
