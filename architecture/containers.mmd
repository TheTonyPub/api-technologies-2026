    System_Ext(spark, "СПАРК Интерфакс", "Внешний источник данных о юридических лицах")
    System_Ext(crm, "CRM", "Система управления отношениями с клиентами")
    System_Ext(abs, "АБС", "Автоматизированная банковская система")

    System_Boundary(platform, "Платформа данных по юрлицам") {

        System_Boundary(dataLayer, "Слой загрузки и хранения") {
            Container(loader, "Loader", "Python/ETL", "Забирает данные из СПАРК Интерфакс и пишет в историческое хранилище")
            ContainerDb(hist, "Historical Store", "PostgreSQL (SCD2)", "Хранит полную историю изменений данных по клиентам")
            Container(enrich, "Enrichment Service", "Python", "Обогащает данные из исторического хранилища")
            ContainerDb(mart, "Online Data Mart", "PostgreSQL/ClickHouse", "Актуальный срез данных для быстрого чтения")
            ContainerDb(cache, "Cache", "Redis, TTL", "Кэш редко изменяющихся данных")
        }

        System_Boundary(serviceLayer, "Сервисный слой") {
            Container(gateway, "API Gateway", "REST/HTTP", "Единая точка входа для внешних потребителей")
            Container(clientinfo, "Client Info Service", "Java/Python", "Информация о клиенте по ИНН")
            Container(groupcomp, "Group Companies Service", "Java/Python", "Все клиенты группы компаний")
            Container(scoring, "Scoring Service", "Python", "Скоринг потенциального клиента")
        }
    }

    Container_Ext(mlmodel, "ML Model", "ML-сервис", "Модель скоринга потенциального клиента")

    Rel(spark, loader, "Отдаёт данные по ЮЛ", "REST")
