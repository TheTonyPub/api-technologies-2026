# Run locally with HOSTING_TYPE=local. For server hosting, set HOSTING_TYPE=server,
# CADDY_NETWORK to the existing Docker network used by Caddy, and
# CADDY_NETWORK_EXTERNAL=true. Enable the homepage service with
# COMPOSE_PROFILES=server in server mode.
HOSTING_TYPE=local
CADDY_NETWORK=seminar04-edge
CADDY_NETWORK_EXTERNAL=false
COMPOSE_PROFILES=
