# Скопируйте в .env и впишите ключ команды. Файл .env в git не коммитить!
API_KEY=

# Адрес моков внешних систем
EXTERNAL_BASE_URL=https://api.external-services.dataprosvet.ru

# Для проверки сбоев можно включить: slow, timeout, error, unavailable, ratelimit. По умолчанию пусто.
MOCK_SCENARIO=

POSTGRES_DB=antifraud
POSTGRES_USER=antifraud
POSTGRES_PASSWORD=antifraud
