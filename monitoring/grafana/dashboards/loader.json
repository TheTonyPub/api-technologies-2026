{
  "uid": "spark-loader",
  "title": "СПАРК · Loader",
  "schemaVersion": 39,
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Доступность Loader",
      "description": "Успешность последнего сбора метрик Prometheus.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "loader-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Недоступен",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Доступен",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"loader\"}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 2,
      "title": "С последнего успешного инкремента",
      "description": "Время с последнего успешного инкремента текущего процесса Loader.",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "loader-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - loader_last_success_timestamp_seconds{phase=\"incremental\"}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "title": "Запуски Loader",
      "description": "Подключения к СПАРК, первичные загрузки и инкременты по исходам, в минуту.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "loader-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (phase, outcome) (rate(loader_runs_total[$__rate_interval])) * 60",
          "legendFormat": "{{phase}} · {{outcome}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Обработка компаний",
      "description": "Обработано за минуту по исходам: обновление, без изменений, пропуск, ошибка.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "loader-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(loader_companies_total[$__rate_interval])) * 60",
          "legendFormat": "{{outcome}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Время обработки компании, p95",
      "description": "От начала работы потока до результата записи. Ожидание свободного потока не входит.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "loader-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(loader_company_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Повторы запросов к СПАРК",
      "description": "Повторы после паузы, в минуту, по операциям SOAP.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "loader-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation) (rate(loader_soap_retries_total[$__rate_interval])) * 60",
          "legendFormat": "{{operation}}",
          "range": true
        }
      ]
    }
  ]
}
