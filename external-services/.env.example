# Домен, на котором Caddy получит TLS-сертификат
DOMAIN=api.external-services.dataprosvet.ru
# Ключи команд для X-API-Key (и Bearer в /notify): команда:ключ через запятую
MOCK_API_KEYS=capacity:CHANGE_ME_1,antifraud:CHANGE_ME_2,spark:CHANGE_ME_3,teacher:CHANGE_ME_4
# Логин и пароль для Authenticate в /spark: команда:логин:пароль через запятую
SPARK_USERS=spark:spark-team:CHANGE_ME_5,teacher:teacher:CHANGE_ME_6
# Фоновые сбои (выключены): доля ответов 503 и диапазон задержки в мс, например 0.02 и 50-300
MOCK_BG_ERROR_RATE=0
MOCK_BG_LATENCY_MS=
